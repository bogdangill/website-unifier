{
	"archiveName": "GB-white-game-1-3-2",
	"websiteName": "Play Peak",
	"name": "unique-boilerplate",
	"version": "0.0.1",
	"description": "boilerplate to unique websites",
	"main": "gulpfile.js",
	"scripts": {
		"start": "gulp dev",
		"build": "gulp build"
	},
	"type": "module",
	"author": "bogdangill",
	"license": "ISC",
	"sourcePaths": [
		{
			"type": "old",
			"images": "assets/img/",
			"styles": "css/styles.scss",
			"stylesCompiled": "css/styles.css",
			"watchStyles": "css/*.scss",
			"cssFileName": "styles.css",
			"scripts": "js/script.js"
		},
		{
			"type": "new",
			"images": "img/",
			"styles": "style/style.scss",
			"stylesCompiled": "style/style.css",
			"cssFileName": "style.css",
			"scripts": "script.js",
			"watchStyles": "style/**/*.scss"
		},
		{
			"type": "mine",
			"images": "images/",
			"styles": "scss/styles.scss",
			"stylesCompiled": "styles.css",
			"cssFileName": "styles.css",
			"scripts": "scripts/*.js",
			"watchStyles": "scss/**/*.scss"
		}
	],
	"devDependencies": {
		"@faker-js/faker": "^9.6.0",
		"browser-sync": "^3.0.3",
		"cheerio": "^1.0.0",
		"del": "^8.0.0",
		"gulp": "^5.0.0",
		"gulp-cached": "^1.1.1",
		"gulp-csso": "^4.0.1",
		"gulp-purgecss": "^7.0.2",
		"gulp-sass": "^6.0.1",
		"gulp-zip": "^5.1.0",
		"libphonenumber-js": "^1.12.6",
		"sass": "^1.86.0",
		"through2": "^4.0.2"
	}
}
